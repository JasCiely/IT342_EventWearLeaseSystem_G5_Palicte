<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Image -->
        <ImageView
            android:id="@+id/idivImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="@color/gray_300"
            android:layout_marginBottom="16dp" />

        <!-- Name + Status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/idtvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/brand_text_dark" />

            <TextView
                android:id="@+id/idtvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp" />
        </LinearLayout>

        <!-- Category -->
        <TextView
            android:id="@+id/idtvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/brand_text_subtitle"
            android:layout_marginBottom="12dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/input_stroke"
            android:layout_marginBottom="14dp" />

        <!-- Price row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRICE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_subtitle"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/idtvPriceOld"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/brand_text_subtitle"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/idtvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/brand_burgundy" />
        </LinearLayout>

        <!-- Promo tag -->
        <TextView
            android:id="@+id/idtvPromoTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#065F46"
            android:background="#D1FAE5"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone" />

        <!-- Sizes -->
        <TextView
            android:id="@+id/idlabelSizes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIZES"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_subtitle"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/idtvSizes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginBottom="14dp"
            android:visibility="gone" />

        <!-- Age Range -->
        <TextView
            android:id="@+id/idlabelAgeRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGE RANGE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_subtitle"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/idtvAgeRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginBottom="14dp"
            android:visibility="gone" />

        <!-- Maintenance -->
        <TextView
            android:id="@+id/idlabelMaintenance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAINTENANCE UNTIL"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_subtitle"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/idtvMaintenance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginBottom="14dp"
            android:visibility="gone" />

        <!-- Description -->
        <TextView
            android:id="@+id/idlabelDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESCRIPTION"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_subtitle"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/idtvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginBottom="14dp"
            android:lineSpacingMultiplier="1.4"
            android:visibility="gone" />

        <!-- Photos -->
        <TextView
            android:id="@+id/idtvPhotos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/brand_text_subtitle"
            android:layout_marginBottom="20dp"
            android:visibility="gone" />

        <!-- Divider before actions -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/input_stroke"
            android:layout_marginBottom="16dp" />

        <!-- Action buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/idbtnEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Edit Item"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            app:backgroundTint="@color/brand_burgundy"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/idbtnDelete"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Delete Item"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#FEE2E2"
            android:textColor="#B91C1C"
            app:cornerRadius="12dp"
            app:strokeColor="#FECACA"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
