<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <!-- Avatar -->
    <com.google.android.material.card.MaterialCardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">
        <TextView
            android:id="@+id/tvHistInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Staff name + status -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHistStaffName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_dark" />

        <TextView
            android:id="@+id/tvHistStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/brand_text_subtitle"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- Late text (normal mode) -->
    <TextView
        android:id="@+id/tvHistLate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginEnd="8dp" />

    <!-- Late toggle (edit mode) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleLate"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:textSize="10sp"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:layout_marginEnd="6dp"
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <!-- Recorded at time -->
    <TextView
        android:id="@+id/tvHistTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/brand_text_subtitle"
        android:layout_marginEnd="6dp" />

    <!-- Status toggle (edit mode only) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleStatus"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:textSize="10sp"
        android:minWidth="0dp"
        android:paddingHorizontal="8dp"
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>
