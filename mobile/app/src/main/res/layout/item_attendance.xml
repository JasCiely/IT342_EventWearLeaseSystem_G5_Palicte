<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_sm"
    android:layout_marginVertical="@dimen/spacing_sm"
    app:cardCornerRadius="@dimen/corner_radius_lg"
    app:cardElevation="@dimen/elevation_sm"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Colored left accent — tinted by adapter -->
        <View
            android:id="@+id/statusAccent"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/success_green" />

        <!-- Main content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_lg"
            android:gravity="center_vertical"
            android:minHeight="@dimen/card_min_height">

            <!-- Staff Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStaffName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Staff Name"
                    android:textSize="@dimen/text_title_medium"
                    android:textStyle="bold"
                    android:textColor="@color/brand_text_dark" />

                <!-- Late indicator -->
                <TextView
                    android:id="@+id/tvLate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/text_body_small"
                    android:textColor="@color/warning_amber"
                    android:textStyle="italic"
                    android:layout_marginTop="@dimen/spacing_xs" />

            </LinearLayout>

            <!-- Status Badge -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_lg"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="0dp"
                android:id="@+id/statusBadgeContainer">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Present"
                    android:textSize="@dimen/text_label_medium"
                    android:textStyle="bold"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
