<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Code + Status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/pdtvCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/brand_burgundy"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/pdtvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp" />
        </LinearLayout>

        <!-- Discount value -->
        <TextView
            android:id="@+id/pdtvDiscount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginBottom="20dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/input_stroke"
            android:layout_marginBottom="16dp" />

        <!-- Date range label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VALIDITY PERIOD"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_subtitle"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />
        <TextView
            android:id="@+id/pdtvDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginBottom="16dp" />

        <!-- Applies to label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APPLIES TO"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_subtitle"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />
        <TextView
            android:id="@+id/pdtvItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginBottom="20dp" />

        <!-- Divider before actions -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/input_stroke"
            android:layout_marginBottom="20dp" />

        <!-- Edit / Delete buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pdbtnEdit"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Edit"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="@color/brand_burgundy"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pdbtnDelete"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Delete"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="#FEE2E2"
                android:textColor="#B91C1C"
                app:cornerRadius="28dp"
                app:strokeColor="#FECACA"
                app:strokeWidth="1.5dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>