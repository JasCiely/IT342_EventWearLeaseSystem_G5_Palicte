<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:padding="24dp">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#DDDDDD" />

    <!-- Title + Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fitting Appointment"
            android:textColor="@color/brand_text_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Pending"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Detail rows -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ITEM"
        android:textColor="@color/brand_text_subtitle"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/tvItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/brand_text_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DATE &amp; TIME"
        android:textColor="@color/brand_text_subtitle"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/tvDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/brand_text_dark"
        android:textSize="14sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PREFERRED SIZE"
        android:textColor="@color/brand_text_subtitle"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/tvSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/brand_text_dark"
        android:textSize="14sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/labelNotes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOTES"
        android:textColor="@color/brand_text_subtitle"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/brand_text_dark"
        android:textSize="14sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />

    <!-- Reschedule button (CONFIRMED only) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReschedule"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="@color/brand_burgundy"
        android:text="Reschedule Appointment"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cornerRadius="10dp" />

    <!-- Cancel button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cancel Booking"
        android:textColor="#DC2626"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        app:cornerRadius="10dp"
        app:strokeColor="#DC2626" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="@color/brand_cream_bg"
        android:text="Close"
        android:textColor="@color/brand_text_dark"
        android:layout_marginBottom="8dp"
        app:cornerRadius="10dp" />

</LinearLayout>
