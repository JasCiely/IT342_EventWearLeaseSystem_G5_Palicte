<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Full Name *" android:textSize="13sp" android:textColor="#718096"
            android:layout_marginBottom="4dp" />
        <EditText android:id="@+id/etFullName" android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input" android:paddingHorizontal="12dp"
            android:inputType="textPersonName" android:layout_marginBottom="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Email *" android:textSize="13sp" android:textColor="#718096"
            android:layout_marginBottom="4dp" />
        <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input" android:paddingHorizontal="12dp"
            android:inputType="textEmailAddress" android:layout_marginBottom="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Role *" android:textSize="13sp" android:textColor="#718096"
            android:layout_marginBottom="4dp" />
        <EditText android:id="@+id/etRole" android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input" android:hint="e.g. Coordinator"
            android:paddingHorizontal="12dp" android:layout_marginBottom="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Status" android:textSize="13sp" android:textColor="#718096"
            android:layout_marginBottom="4dp" />
        <Spinner android:id="@+id/spStatus" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginBottom="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Custom Rate (₱/day, optional)" android:textSize="13sp" android:textColor="#718096"
            android:layout_marginBottom="4dp" />
        <EditText android:id="@+id/etCustomRate" android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input" android:paddingHorizontal="12dp"
            android:inputType="numberDecimal" android:layout_marginBottom="4dp" />

    </LinearLayout>
</ScrollView>
