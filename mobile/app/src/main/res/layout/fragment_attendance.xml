<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_cream_bg">

    <!-- ─── Modern Toolbar ─── -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand_burgundy"
        android:title="Attendance"
        android:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="#FFFFFF"
        android:elevation="@dimen/elevation_md"
        app:elevation="@dimen/elevation_md" />

    <!-- ─── Header Card with Status & Actions ─── -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_lg"
        app:cardCornerRadius="@dimen/corner_radius_lg"
        app:cardElevation="@dimen/elevation_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Date & Session Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/spacing_md">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today: --"
                    android:textSize="@dimen/text_title_medium"
                    android:textStyle="bold"
                    android:textColor="@color/brand_text_dark" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <View
                        android:layout_width="@dimen/spacing_sm"
                        android:layout_height="@dimen/spacing_sm"
                        android:background="@color/success_green"
                        android:layout_marginEnd="@dimen/spacing_sm" />

                    <TextView
                        android:id="@+id/tvSessionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No session yet"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="@color/brand_text_subtitle" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="fill_horizontal"
                android:spacing="@dimen/spacing_md">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecord"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:text="Record Today"
                    android:textAllCaps="false"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    style="@style/Widget.Material3.Button"
                    app:backgroundTint="@color/brand_burgundy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnlock"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:text="Unlock"
                    android:textAllCaps="false"
                    android:layout_marginStart="@dimen/spacing_sm"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="@color/brand_gold"
                    android:textColor="@color/brand_burgundy" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ─── Records List with Swipe Refresh ─── -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_lg"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="@dimen/spacing_2xl">

                <ImageView
                    android:layout_width="@dimen/spacing_3xl"
                    android:layout_height="@dimen/spacing_3xl"
                    android:src="@drawable/ic_visibility_off"
                    android:tint="@color/brand_text_subtitle"
                    android:alpha="0.5"
                    android:layout_marginBottom="@dimen/spacing_lg"
                    android:contentDescription="No records" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No attendance records today"
                    android:textColor="@color/brand_text_subtitle"
                    android:textSize="@dimen/text_body_medium"
                    android:gravity="center"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start by recording today's attendance"
                    android:textColor="@color/brand_text_subtitle"
                    android:textSize="@dimen/text_body_small"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:alpha="0.7" />
            </LinearLayout>
        </RelativeLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
