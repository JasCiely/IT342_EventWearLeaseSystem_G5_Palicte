<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_cream_bg">

    <!-- ── Header ── -->
    <LinearLayout
        android:id="@+id/appHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_burgundy"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse Collection"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find your perfect outfit"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHeaderInitials"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_white_36"
            android:gravity="center"
            android:text="?"
            android:textColor="@color/brand_burgundy"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ── Fragment Container ── -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ── Bottom Navigation ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_card_white"
        android:elevation="8dp"
        android:orientation="horizontal">

        <!-- Browse -->
        <LinearLayout
            android:id="@+id/navBrowse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/ivNavBrowse"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_shopping_bag"
                app:tint="@color/brand_burgundy" />

            <TextView
                android:id="@+id/tvNavBrowse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Browse"
                android:textColor="@color/brand_burgundy"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- My Bookings -->
        <LinearLayout
            android:id="@+id/navMyBookings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/ivNavBookings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_bookings"
                app:tint="@color/brand_text_subtitle" />

            <TextView
                android:id="@+id/tvNavBookings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Bookings"
                android:textColor="@color/brand_text_subtitle"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Notifications -->
        <LinearLayout
            android:id="@+id/navNotifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/ivNavNotifications"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/brand_text_subtitle" />

                <TextView
                    android:id="@+id/tvAlertBadge"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge_red"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvNavNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Alerts"
                android:textColor="@color/brand_text_subtitle"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/ivNavProfile"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_person"
                app:tint="@color/brand_text_subtitle" />

            <TextView
                android:id="@+id/tvNavProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Profile"
                android:textColor="@color/brand_text_subtitle"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
