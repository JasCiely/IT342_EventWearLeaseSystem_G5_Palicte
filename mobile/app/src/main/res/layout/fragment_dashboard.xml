<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ════════════════════════════════════════════════════════
             HEADER — burgundy gradient-style panel
             ════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_burgundy"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:alpha="0.65"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome, Admin"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_dashboard_subtitle"
                android:textColor="#FFFFFF"
                android:alpha="0.8"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- ════════════════════════════════════════════════════════
             OVERVIEW STATS — 2-column grid
             ════════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_overview"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="@color/brand_text_dark"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:columnOrderPreserved="false">

            <!-- Total Users -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/brand_surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <View android:layout_width="match_parent" android:layout_height="3dp"
                        android:background="@color/info_blue" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/dashboard_total_users"
                            android:textSize="11sp" android:textColor="@color/brand_text_subtitle" android:textAllCaps="true"
                            android:letterSpacing="0.06" />
                        <TextView android:id="@+id/tvStatUsers"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textSize="30sp" android:textStyle="bold"
                            android:textColor="@color/info_blue" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Fitting Bookings -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/brand_surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <View android:layout_width="match_parent" android:layout_height="3dp"
                        android:background="@color/warning_amber" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/dashboard_fitting_bookings"
                            android:textSize="11sp" android:textColor="@color/brand_text_subtitle" android:textAllCaps="true"
                            android:letterSpacing="0.06" />
                        <TextView android:id="@+id/tvStatFitting"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textSize="30sp" android:textStyle="bold"
                            android:textColor="@color/warning_amber" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Direct Leases -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/brand_surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <View android:layout_width="match_parent" android:layout_height="3dp"
                        android:background="@color/brand_burgundy" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/dashboard_direct_leases"
                            android:textSize="11sp" android:textColor="@color/brand_text_subtitle" android:textAllCaps="true"
                            android:letterSpacing="0.06" />
                        <TextView android:id="@+id/tvStatDirect"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textSize="30sp" android:textStyle="bold"
                            android:textColor="@color/brand_burgundy" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Total Items -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/brand_surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <View android:layout_width="match_parent" android:layout_height="3dp"
                        android:background="@color/brand_gold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/dashboard_total_items"
                            android:textSize="11sp" android:textColor="@color/brand_text_subtitle" android:textAllCaps="true"
                            android:letterSpacing="0.06" />
                        <TextView android:id="@+id/tvStatInventory"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textSize="30sp" android:textStyle="bold"
                            android:textColor="@color/brand_gold" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Available Items -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/brand_surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <View android:layout_width="match_parent" android:layout_height="3dp"
                        android:background="@color/success_green" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/dashboard_available"
                            android:textSize="11sp" android:textColor="@color/brand_text_subtitle" android:textAllCaps="true"
                            android:letterSpacing="0.06" />
                        <TextView android:id="@+id/tvStatAvailable"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textSize="30sp" android:textStyle="bold"
                            android:textColor="@color/success_green" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Staff -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/brand_surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <View android:layout_width="match_parent" android:layout_height="3dp"
                        android:background="@color/brand_burgundy_light" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/dashboard_staff"
                            android:textSize="11sp" android:textColor="@color/brand_text_subtitle" android:textAllCaps="true"
                            android:letterSpacing="0.06" />
                        <TextView android:id="@+id/tvStatStaff"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textSize="30sp" android:textStyle="bold"
                            android:textColor="@color/brand_burgundy_light" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <!-- ════════════════════════════════════════════════════════
             DIRECT BOOKING PIPELINE
             ════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_pipeline_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="@color/brand_text_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Direct Bookings"
                android:textSize="11sp"
                android:textColor="@color/brand_text_subtitle" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Pending -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/status_pending_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Pending" android:textSize="10sp"
                            android:textColor="@color/status_pending_text" android:textStyle="bold"
                            android:textAllCaps="true" android:letterSpacing="0.05" />
                        <TextView android:id="@+id/tvPipelinePending"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textSize="26sp" android:textStyle="bold"
                            android:textColor="@color/status_pending_text" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Arrow -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="›" android:textSize="22sp"
                    android:textColor="@color/brand_text_subtitle"
                    android:layout_marginEnd="8dp" />

                <!-- Approved -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/status_confirmed_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Approved" android:textSize="10sp"
                            android:textColor="@color/status_confirmed_text" android:textStyle="bold"
                            android:textAllCaps="true" android:letterSpacing="0.05" />
                        <TextView android:id="@+id/tvPipelineApproved"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textSize="26sp" android:textStyle="bold"
                            android:textColor="@color/status_confirmed_text" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Arrow -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="›" android:textSize="22sp"
                    android:textColor="@color/brand_text_subtitle"
                    android:layout_marginEnd="8dp" />

                <!-- Active Lease -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/status_active_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Active" android:textSize="10sp"
                            android:textColor="@color/status_active_text" android:textStyle="bold"
                            android:textAllCaps="true" android:letterSpacing="0.05" />
                        <TextView android:id="@+id/tvPipelineActive"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textSize="26sp" android:textStyle="bold"
                            android:textColor="@color/status_active_text" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Arrow -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="›" android:textSize="22sp"
                    android:textColor="@color/brand_text_subtitle"
                    android:layout_marginEnd="8dp" />

                <!-- Returned -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFF3E0">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Returned" android:textSize="10sp"
                            android:textColor="#E65100" android:textStyle="bold"
                            android:textAllCaps="true" android:letterSpacing="0.05" />
                        <TextView android:id="@+id/tvPipelineReturned"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textSize="26sp" android:textStyle="bold"
                            android:textColor="#E65100" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Arrow -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="›" android:textSize="22sp"
                    android:textColor="@color/brand_text_subtitle"
                    android:layout_marginEnd="8dp" />

                <!-- Completed -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/status_completed_bg">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Done" android:textSize="10sp"
                            android:textColor="@color/status_completed_text" android:textStyle="bold"
                            android:textAllCaps="true" android:letterSpacing="0.05" />
                        <TextView android:id="@+id/tvPipelineCompleted"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="--" android:textSize="26sp" android:textStyle="bold"
                            android:textColor="@color/status_completed_text" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- ════════════════════════════════════════════════════════
             FITTING SNAPSHOT
             ════════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_fitting_snapshot"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="@color/brand_text_dark"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <!-- Fitting Pending -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/status_pending_bg">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pending" android:textSize="10sp"
                        android:textColor="@color/status_pending_text" android:textAllCaps="true"
                        android:letterSpacing="0.05" />
                    <TextView android:id="@+id/tvFittingPending"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="24sp" android:textStyle="bold"
                        android:textColor="@color/status_pending_text" android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Fitting Confirmed -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/status_confirmed_bg">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Confirmed" android:textSize="10sp"
                        android:textColor="@color/status_confirmed_text" android:textAllCaps="true"
                        android:letterSpacing="0.05" />
                    <TextView android:id="@+id/tvFittingConfirmed"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="24sp" android:textStyle="bold"
                        android:textColor="@color/status_confirmed_text" android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Fitting Done -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/status_completed_bg">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Done" android:textSize="10sp"
                        android:textColor="@color/status_completed_text" android:textAllCaps="true"
                        android:letterSpacing="0.05" />
                    <TextView android:id="@+id/tvFittingDone"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="24sp" android:textStyle="bold"
                        android:textColor="@color/status_completed_text" android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ════════════════════════════════════════════════════════
             FOOTER — live updates indicator
             ════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_green" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  Live updates enabled"
                android:textSize="12sp"
                android:textColor="@color/success_green" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="16dp" />

    </LinearLayout>

</ScrollView>
