<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:elevation="4dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@color/gray_300"
        android:alpha="0.7" />

    <!-- Header: Booking ID + Customer Name + Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBookingId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/brand_text_subtitle"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                tools:text="#DR1779273012124" />

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/brand_text_dark"
                android:layout_marginTop="4dp"
                tools:text="Customer Name" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Direct Rental"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/info_blue"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_badge_confirmed" />

                <TextView
                    android:id="@+id/tvExtendedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extended"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/info_blue"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_confirmed"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:layout_marginStart="12dp"
            tools:text="Pending" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_300"
        android:alpha="0.5" />

    <!-- Scrollable content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <!-- ITEM section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ITEM"
                android:textSize="10sp"
                android:textColor="@color/brand_text_subtitle"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/brand_text_dark"
                tools:text="Jasmine Evening Gown" />

            <TextView
                android:id="@+id/tvItemSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/brand_text_subtitle"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Size: M" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_300"
                android:layout_marginVertical="16dp"
                android:alpha="0.5" />

            <!-- CUSTOMER section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOMER"
                android:textSize="10sp"
                android:textColor="@color/brand_text_subtitle"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvCustomerEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/brand_text_dark"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="✉  customer@email.com" />

            <TextView
                android:id="@+id/tvCustomerPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/brand_text_dark"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="📞  +63912345678" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_300"
                android:layout_marginVertical="16dp"
                android:alpha="0.5" />

            <!-- RENTAL SCHEDULE header row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RENTAL SCHEDULE"
                    android:textSize="10sp"
                    android:textColor="@color/brand_text_subtitle"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true" />

                <Button
                    android:id="@+id/btnEditDatesInline"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Edit Dates"
                    android:textSize="12sp"
                    android:textColor="@color/brand_burgundy"
                    android:background="@drawable/bg_button_outline"
                    android:paddingHorizontal="16dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Start / End / Days cards – subtle elevation and even spacing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_white"
                    android:padding="12dp"
                    android:layout_marginEnd="4dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="START"
                        android:textSize="9sp"
                        android:textColor="@color/brand_text_subtitle"
                        android:letterSpacing="0.1"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/tvStartDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_text_dark"
                        android:layout_marginTop="6dp"
                        tools:text="2026-05-21" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_white"
                    android:padding="12dp"
                    android:layout_marginHorizontal="4dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="END"
                        android:textSize="9sp"
                        android:textColor="@color/brand_text_subtitle"
                        android:letterSpacing="0.1"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/tvEndDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_text_dark"
                        android:layout_marginTop="6dp"
                        tools:text="2026-05-24" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_white"
                    android:padding="12dp"
                    android:layout_marginStart="4dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DAYS"
                        android:textSize="9sp"
                        android:textColor="@color/brand_text_subtitle"
                        android:letterSpacing="0.1"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/tvTotalDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_text_dark"
                        android:layout_marginTop="6dp"
                        tools:text="3" />

                </LinearLayout>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_300"
                android:layout_marginVertical="16dp"
                android:alpha="0.5" />

            <!-- PAYMENT section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAYMENT"
                android:textSize="10sp"
                android:textColor="@color/brand_text_subtitle"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="16dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Base Price"
                        android:textSize="14sp"
                        android:textColor="@color/brand_text_subtitle" />
                    <TextView
                        android:id="@+id/tvBasePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/brand_text_dark"
                        android:textStyle="bold"
                        tools:text="₱1,500.00" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    tools:visibility="visible">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Discount"
                        android:textSize="14sp"
                        android:textColor="@color/success_green" />
                    <TextView
                        android:id="@+id/tvDiscount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/success_green"
                        android:textStyle="bold"
                        tools:text="-₱200.00" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_300"
                    android:layout_marginVertical="12dp"
                    android:alpha="0.5" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_text_dark" />
                    <TextView
                        android:id="@+id/tvFinalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_burgundy"
                        tools:text="₱1,300.00" />
                </LinearLayout>

            </LinearLayout>

            <!-- NOTES section (conditional) -->
            <View
                android:id="@+id/notesDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_300"
                android:layout_marginVertical="16dp"
                android:alpha="0.5"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvNotesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTES"
                android:textSize="10sp"
                android:textColor="@color/brand_text_subtitle"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/brand_text_dark"
                android:background="@drawable/bg_card_white"
                android:padding="14dp"
                android:elevation="2dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Customer notes go here." />

        </LinearLayout>

    </ScrollView>

    <!-- Footer divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_300"
        android:alpha="0.5" />

    <!-- ── Action buttons footer ──────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Pickup day warning banner (full width, conditional) -->
        <LinearLayout
            android:id="@+id/layoutPickupWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_warning_banner"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pickup scheduled for today. Tap Picked Up once the customer collects the item, or cancel."
                android:textSize="13sp"
                android:textColor="#92400E"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <!-- PRIMARY action: full-width (only one will be visible at a time) -->
        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Approve Booking"
            android:textColor="#FFFFFF"
            android:backgroundTint="#15803D"
            android:layout_marginBottom="10dp"
            android:elevation="2dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnPickup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Mark Picked Up"
            android:textColor="#FFFFFF"
            android:backgroundTint="#15803D"
            android:layout_marginBottom="10dp"
            android:elevation="2dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnReturn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Mark Returned"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0D9488"
            android:layout_marginBottom="10dp"
            android:elevation="2dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Active Lease secondary: [Extend Lease] [Undo Pickup] side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnExtendLease"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Extend Lease"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6B2D39"
                android:layout_marginEnd="4dp"
                android:elevation="2dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/btnUndoPickup"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Undo Pickup"
                android:textColor="@color/brand_text_dark"
                android:background="@drawable/bg_button_outline"
                android:layout_marginStart="4dp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Pending / Approved secondary: [Edit Rental Dates] [Cancel Booking] side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnEditDates"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Edit Dates"
                android:textColor="@color/brand_text_dark"
                android:background="@drawable/bg_button_outline"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="#FFFFFF"
                android:backgroundTint="#991B1B"
                android:layout_marginStart="4dp"
                android:elevation="2dp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Always visible: Resend Email (full width) -->
        <Button
            android:id="@+id/btnResendEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Resend Email"
            android:textColor="@color/brand_text_dark"
            android:background="@drawable/bg_button_outline" />

    </LinearLayout>

</LinearLayout>