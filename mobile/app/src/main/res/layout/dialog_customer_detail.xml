<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_cream_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Avatar + Name header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <FrameLayout
                android:id="@+id/cdAvatarFrame"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/circle_burgundy_light">
                <TextView
                    android:id="@+id/cdInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/cdFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_text_dark" />
                <TextView
                    android:id="@+id/cdRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/brand_gold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/cdStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_nav_active"
                android:textColor="@color/brand_burgundy" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/input_stroke"
            android:layout_marginBottom="16dp" />

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMAIL"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_subtitle"
            android:layout_marginBottom="4dp" />
        <TextView
            android:id="@+id/cdEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginBottom="14dp" />

        <!-- Phone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHONE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_subtitle"
            android:layout_marginBottom="4dp" />
        <TextView
            android:id="@+id/cdPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginBottom="14dp" />

        <!-- Joined -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JOINED"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_subtitle"
            android:layout_marginBottom="4dp" />
        <TextView
            android:id="@+id/cdJoined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginBottom="14dp" />

        <!-- Last Login -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LAST LOGIN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brand_text_subtitle"
            android:layout_marginBottom="4dp" />
        <TextView
            android:id="@+id/cdLastLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/brand_text_dark"
            android:layout_marginBottom="20dp" />

        <!-- Toggle Status Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cdBtnToggle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Deactivate"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_burgundy"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>